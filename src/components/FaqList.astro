---
import type { FaqItem } from '../lib/seo';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item) => (
      <details class="faq-list__item">
        <summary class="faq-list__question">{item.question}</summary>
        <p class="faq-list__answer">{item.answer}</p>
      </details>
    ))
  }
</div>

