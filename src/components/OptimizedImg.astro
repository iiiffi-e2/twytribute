---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { imageSrcSet, optimizeImageUrl, resolveImgSize } from '../lib/images';

import bandBarnGroup from '../../public/assets/band-barn-group.jpg';
import bandTree1 from '../../public/assets/band-tree1.jpg';
import bandTree2 from '../../public/assets/band-tree2.jpg';
import bandWall from '../../public/assets/band-wall.jpg';
import bwBarnBand from '../../public/assets/bw-barn-band.jpg';
import bwDuo from '../../public/assets/bw-duo.jpg';
import bwGuitarCase from '../../public/assets/bw-guitar-case.jpg';
import bwPedals from '../../public/assets/bw-pedals.jpg';
import liveCrowd from '../../public/assets/live-crowd.jpg';
import logoTwy from '../../public/assets/logo-twy.png';
import longhornSign from '../../public/assets/longhorn-sign.jpg';
import twyHero2 from '../../public/assets/twy-hero-2.jpg';
import twyIcon from '../../public/assets/twyicon.png';
import twyLive1 from '../../public/assets/twy-live1.jpg';
import vocalGreen from '../../public/assets/vocal-green.jpg';

const LOCAL_IMAGES: Record<string, ImageMetadata> = {
  '/assets/band-barn-group.jpg': bandBarnGroup,
  '/assets/band-tree1.jpg': bandTree1,
  '/assets/band-tree2.jpg': bandTree2,
  '/assets/band-wall.jpg': bandWall,
  '/assets/bw-barn-band.jpg': bwBarnBand,
  '/assets/bw-duo.jpg': bwDuo,
  '/assets/bw-guitar-case.jpg': bwGuitarCase,
  '/assets/bw-pedals.jpg': bwPedals,
  '/assets/live-crowd.jpg': liveCrowd,
  '/assets/logo-twy.png': logoTwy,
  '/assets/longhorn-sign.jpg': longhornSign,
  '/assets/twy-hero-2.jpg': twyHero2,
  '/assets/twyicon.png': twyIcon,
  '/assets/twy-live1.jpg': twyLive1,
  '/assets/vocal-green.jpg': vocalGreen,
};

interface Props {
  src: string;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'auto' | 'sync';
  width?: number;
  height?: number;
  zoom?: boolean;
  objectPosition?: string;
}

const {
  src,
  alt,
  class: className,
  widths = [480, 768, 1080],
  sizes = '(max-width: 768px) 100vw, 800px',
  loading = 'lazy',
  fetchpriority = 'auto',
  decoding = 'async',
  width,
  height,
  zoom = false,
  objectPosition,
} = Astro.props;

const imgStyle = objectPosition ? `object-position: ${objectPosition};` : undefined;

const local = LOCAL_IMAGES[src];
const fallbackWidth = width ?? widths[widths.length - 1] ?? 800;
const displaySize = resolveImgSize(
  src,
  { width: fallbackWidth, height },
  local ? { width: local.width, height: local.height } : undefined,
);
const remoteSrc = optimizeImageUrl(src, { width: fallbackWidth });
const remoteSrcSet = src.startsWith('http') ? imageSrcSet(src, widths) : undefined;
---

{
  local ? (
    <Picture
      src={local}
      alt={alt}
      class={className}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      width={displaySize.width}
      height={displaySize.height}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      data-zoom-img={zoom ? '' : undefined}
      style={imgStyle}
    />
  ) : (
    <img
      src={remoteSrc}
      srcset={remoteSrcSet}
      sizes={remoteSrcSet ? sizes : undefined}
      alt={alt}
      class={className}
      width={displaySize.width}
      height={displaySize.height}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      data-zoom-img={zoom ? '' : undefined}
      style={imgStyle}
    />
  )
}
